generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUTHOR
  STUDENT
}

model User {
  id String @id @default(uuid())

  firebaseUid String @unique

  email String? @unique
  phone String? @unique

  fullName String

  gender String?

  collegeName String?
  rollNumber  String?

  role UserRole @default(STUDENT)

  approved Boolean @default(false)

  blocked Boolean @default(false)

  coinBalance Int @default(0) // cache of SUM(CoinTransaction.amount)

  savedRecipientName String?
  savedAddressLine1  String?
  savedAddressLine2  String?
  savedCity          String?
  savedState         String?
  savedPostalCode    String?
  savedCountry       String?
  savedContactPhone  String?

  groupMemberships UserGroup[]
  createdGroups    Group[]          @relation("GroupCreator")
  createdQuizzes   Quiz[]           @relation("QuizCreator")
  createdQuestions Question[]       @relation("QuestionCreator")
  quizSubmissions  QuizSubmission[]

  fcmTokens             FcmToken[]
  createdNotifications  Notification[] @relation("NotificationCreator")
  receivedNotifications Notification[] @relation("NotificationRecipient")

  coinTransactions       CoinTransaction[] @relation("CoinTransactionUser")
  coinAdjustmentsCreated CoinTransaction[] @relation("CoinTransactionCreator")
  createdStoreItems      StoreItem[]
  redemptions            Redemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id String @id @default(uuid())

  name String @unique

  description String?

  createdById String

  createdBy User @relation("GroupCreator", fields: [createdById], references: [id])

  members UserGroup[]

  allowedQuizzes QuizAllowedGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserGroup {
  userId  String
  groupId String

  user User @relation(fields: [userId], references: [id])

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, groupId])
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id    String           @id @default(uuid())
  title String
  body  String
  type  NotificationType @default(ANNOUNCEMENT)

  // Targeting
  targetType NotifTargetType @default(ALL)
  groupId    String? // set when targetType = GROUP

  recipientUserId String? // set when targetType = USER
  recipientUser   User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  // Scheduling
  sendAt DateTime? // null = immediate
  sentAt DateTime? // null = not yet sent
  status NotifStatus @default(PENDING)

  createdById String
  createdBy   User   @relation("NotificationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientUserId])
}

model Quiz {
  id String @id @default(uuid())

  title String

  description String?

  coverImageUrl String?

  visibility QuizVisibility @default(PUBLIC)

  defaultTimer Int

  status QuizStatus @default(DRAFT)

  scheduledStartTime DateTime

  actualStartTime DateTime?

  completedAt DateTime?

  createdById String

  createdBy User @relation("QuizCreator", fields: [createdById], references: [id])

  quizQuestions QuizQuestionMap[]

  allowedGroups QuizAllowedGroup[]

  submissions QuizSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id String @id @default(uuid())

  questionText String

  questionType QuestionType @default(SINGLE_CORRECT)

  mediaUrl String?

  customTimer Int?

  createdById String?

  createdBy User? @relation("QuestionCreator", fields: [createdById], references: [id])

  options QuestionOption[]

  quizzes QuizQuestionMap[]

  submissions QuizSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionOption {
  id String @id @default(uuid())

  questionId String

  optionText String

  isCorrect Boolean @default(false)

  orderIndex Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizQuestionMap {
  quizId String

  questionId String

  orderIndex Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
}

model QuizAllowedGroup {
  quizId String

  groupId String

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([quizId, groupId])
}

model QuizSubmission {
  id String @id @default(cuid())

  quizId     String
  userId     String
  questionId String

  selectedOptionIds String[]

  correct Boolean

  score Int

  elapsedMs Int

  submittedAt DateTime

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId, questionId])
  @@index([quizId])
  @@index([userId])
  @@index([questionId])
}

model CoinTransaction {
  id String @id @default(uuid())

  userId String
  user   User   @relation("CoinTransactionUser", fields: [userId], references: [id], onDelete: Restrict)

  amount Int // positive = credit, negative = debit

  type CoinTransactionType

  referenceType CoinReferenceType?
  referenceId   String? // quiz or redemption id

  description String?

  createdById String?
  createdBy   User?   @relation("CoinTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([userId, referenceType, referenceId, type])
  @@index([userId, createdAt])
}

model StoreItem {
  id String @id @default(uuid())

  name        String
  description String?
  imageUrl    String?

  coinCost Int

  stock Int @default(0)

  status StoreItemStatus @default(ACTIVE)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  redemptions Redemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Redemption {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id], onDelete: Restrict)

  coinCost Int

  recipientName String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String  @default("India")
  contactPhone  String

  status RedemptionStatus @default(REQUESTED)

  expectedDeliveryAt DateTime?

  adminNote       String? // admin-only
  rejectionReason String? // shown to student on REJECTED

  addressEditedAt DateTime? // set only on student address edits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([storeItemId])
}

enum CoinTransactionType {
  QUIZ_REWARD
  REDEMPTION_DEBIT
  REDEMPTION_REFUND
  ADMIN_ADJUSTMENT
}

enum CoinReferenceType {
  QUIZ
  REDEMPTION
}

enum StoreItemStatus {
  ACTIVE
  INACTIVE
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  SHIPPED
  DELIVERED
  REJECTED
}

enum NotificationType {
  QUIZ_REMINDER
  ANNOUNCEMENT
  CONTEST
  RESULT
}

enum NotifTargetType {
  ALL
  GROUP
  APPROVED_ONLY
  USER
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
}

enum QuizVisibility {
  PUBLIC
  RESTRICTED
}

enum QuestionType {
  SINGLE_CORRECT
  MULTI_CORRECT
  TEXT
  NUMERIC
}

enum QuizStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}
